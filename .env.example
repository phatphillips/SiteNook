PB_ADMIN_EMAIL=admin@sitenook.local
PB_ADMIN_PASSWORD=changeme_strong_password_here
APP_USER_EMAIL=admin@sitenook.local
APP_USER_PASSWORD=changeme_app_password
# Default org for single-tenant / dev backfill (subdomain slug, used until Phase B subdomain routing)
DEFAULT_ORG_SUBDOMAIN=default
DEFAULT_ORG_NAME=Default Organization
# Browser PocketBase URL: /api when behind nginx (docker compose up); http://localhost:8090 for local dev
NUXT_PUBLIC_POCKETBASE_URL=/api
NUXT_PUBLIC_APP_URL=http://localhost
# Hostname used to parse tenant subdomains (sitenook.com in production, localhost in dev)
NUXT_PUBLIC_APP_DOMAIN=localhost
# Production: set true so apex (sitenook.com) shows /find-account instead of dashboard login.
# Dev localhost apex is unaffected — see docs/Go live.md
# NUXT_PUBLIC_TENANT_ONLY=true
# Phase G: apex marketing landing at / (independent of self-service signup)
# NUXT_PUBLIC_MARKETING_SITE=true
# Server-side PocketBase URL for Nitro (Docker: http://pocketbase:8090; local dev: http://localhost:8090)
NUXT_POCKETBASE_URL=http://pocketbase:8090
# Superuser credentials for server-only tenant resolution (use same values as PB_ADMIN_*)
# NUXT_PB_ADMIN_EMAIL=admin@sitenook.local
# NUXT_PB_ADMIN_PASSWORD=changeme_strong_password_here
# Shared secret for POST /api/provision (org onboarding — server only, never expose to browser)
# NUXT_PROVISION_API_KEY=changeme_provision_secret
# Contact email shown on /signup (invite-only page)
# NUXT_PUBLIC_SUPPORT_EMAIL=contact@your-org.com
# Self-service org signup wizard at /start (Phase F) — off by default
# NUXT_PUBLIC_SELF_SERVICE_SIGNUP=true
#
# --- Stripe (Phase G) — test mode first; see docs/stripe-setup.md ---
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NUXT_STRIPE_SECRET_KEY=sk_test_...
# NUXT_STRIPE_STARTER_PRICE_ID=price_...
# NUXT_STRIPE_TEAM_PRICE_ID=price_...
# NUXT_STRIPE_BUSINESS_PRICE_ID=price_...
# NUXT_STRIPE_STANDARD_PRICE_ID=price_...   # legacy alias for team monthly price
# NUXT_STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
# NUXT_STRIPE_TEAM_ANNUAL_PRICE_ID=price_...
# NUXT_STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_...
# Self-host licence (appliance unlock) — see docs/platform/public-sku-sheet.md
# NUXT_STRIPE_SELFHOST_PRICE_ID=price_...
# NUXT_STRIPE_SELFHOST_ANNUAL_PRICE_ID=price_...
# If your Stripe customer/subscription uses AUD (or other currency), add matching Price IDs:
# NUXT_STRIPE_STARTER_PRICE_ID_AUD=price_...
# NUXT_STRIPE_TEAM_PRICE_ID_AUD=price_...
# NUXT_STRIPE_BUSINESS_PRICE_ID_AUD=price_...
# NUXT_STRIPE_WEBHOOK_SECRET=whsec_...
# Local dev without Stripe keys — /start?checkout=dev_bypass (localhost only)
# NUXT_PUBLIC_STRIPE_DEV_BYPASS=true
# NUXT_STRIPE_DEV_BYPASS_TOKEN=dev_bypass
# Cloudflare Turnstile (recommended in production for /api/signup-organization)
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# NUXT_TURNSTILE_SECRET=
# NUXT_PUBLIC_TERMS_URL=https://sitenook.com/terms
# Required for production web builds (NODE_ENV=production). Use /api behind nginx.
# Dashboard URL embedded in PocketBase password-reset emails (patch-users.sh on boot)
APP_DASHBOARD_URL=http://localhost:3000
# Tenant subdomain suffix for mailer_tenant_reset.pb.js (docker-compose sets from NUXT_PUBLIC_APP_DOMAIN)
# APP_PUBLIC_DOMAIN=localhost
#
# --- Email / SMTP (PocketBase admin UI, not .env) ---
# Invites and password resets require SMTP in PocketBase: /_/ → Settings → Mail settings.
# Dev: Gmail smtp.gmail.com:587 + app password (often lands in spam — OK for local testing).
# Prod: use Resend (smtp.resend.com, user: resend, pass: API key) or SendGrid on a verified domain.
# Set From to noreply@yourdomain.com; align APP_DASHBOARD_URL + NUXT_PUBLIC_APP_DOMAIN with prod DNS.
# See docs/On_boarding.md § Email deliverability for SPF/DKIM/DMARC and verification steps.
SCANNER_CONCURRENCY=3
SCANNER_MAX_PAGES=500
SCANNER_POLL_INTERVAL_MS=10000
# Phase I: purge closed organizations after 30-day retention (optional)
# SCANNER_PURGE_CLOSED_ORGS=true
# SCANNER_PURGE_TICK_MS=86400000
SCHEDULER_TICK_MS=60000
SCANNER_TIMEZONE=UTC
# Set to 1 for per-URL crawl skip/failure logs in scanner container output
SCANNER_CRAWL_DEBUG=0
# Hybrid write batching: flush child records every N pages (default 5; set 1 to disable)
SCANNER_FLUSH_EVERY_PAGES=5
# Optional BullMQ + Redis for multi-worker scan dispatch (docker compose --profile queue)
# SCANNER_BULLMQ_ENABLED=1
# BULLMQ_REDIS_URL=redis://redis:6379
# SCANNER_WORKER_CONCURRENCY=2
#
# --- Analytics integrations (Settings → Integrations) ---
# 32-byte key, base64-encoded: openssl rand -base64 32
# ANALYTICS_CREDENTIALS_ENCRYPTION_KEY=
# GA4_OAUTH_CLIENT_ID=
# GA4_OAUTH_CLIENT_SECRET=
# ANALYTICS_SYNC_ENABLED=1
# ANALYTICS_SYNC_TICK_MS=300000
#
# --- Litestream backup (docker compose --profile backup) ---
# LITESTREAM_S3_BUCKET=your-bucket
# LITESTREAM_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_S3_REGION=us-east-005
#
# --- Enterprise / Self-host licence API (apex deployment) ---
# NUXT_LICENCE_SIGNING_SECRET=changeme-long-random-secret
# Optional dedicated secret for content-preview snapshot tickets (falls back to licence secret)
# NUXT_PREVIEW_SIGNING_SECRET=changeme-preview-signing-secret
# NUXT_LICENCE_ADMIN_KEY=changeme-admin-key-for-revoke-endpoint
#
# --- Appliance mode (Community / Self-host Docker) ---
# SITENOOK_DEPLOYMENT_MODE=appliance
# SITENOOK_LICENCE_KEY=
# SITENOOK_LICENCE_SERVER_URL=https://sitenook.com
# SITENOOK_INSTANCE_DOMAIN=access.example.gov.au
# SITENOOK_INSTANCE_FINGERPRINT=
# Optional override for Playwright page loads (default: desktop Chrome UA without HeadlessChrome)
# SCANNER_USER_AGENT=Mozilla/5.0 ...
# SCANNER_BROWSER_LOCALE=en-AU
#
# --- PDF accessibility (veraPDF REST + OpenDataLoader remediation sidecars) ---
# VERAPDF_URL=http://verapdf:8080
# OPENDATALOADER_URL=http://opendataloader:8095
# ODL_MAX_BYTES=20971520
# ODL_TIMEOUT_SEC=180
#
# --- Global search (Typesense) ---
# Required for /search. Override TYPESENSE_API_KEY in production with a strong random value.
TYPESENSE_API_KEY=dev-typesense-key-local-only
TYPESENSE_URL=http://typesense:8108
TYPESENSE_ENABLED=1
