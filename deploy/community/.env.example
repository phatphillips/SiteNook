PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme_strong_password
APP_USER_EMAIL=admin@example.com
APP_USER_PASSWORD=changeme_app_password

NUXT_PUBLIC_APP_URL=http://localhost
NUXT_PUBLIC_APP_DOMAIN=localhost

# Leave empty for Community Free caps (1 site / 20 pages).
# After Polar purchase, paste the licence key emailed to you.
SITENOOK_LICENCE_KEY=
# Leave empty until Polar licence validation is wired (v1).
SITENOOK_LICENCE_SERVER_URL=
SITENOOK_INSTANCE_DOMAIN=localhost

# Optional search (docker compose --profile search up -d)
TYPESENSE_ENABLED=0
TYPESENSE_API_KEY=

# Override published image tags if needed
# SITENOOK_WEB_IMAGE=ghcr.io/phatphillips/sitenook-web:latest
# SITENOOK_SCANNER_IMAGE=ghcr.io/phatphillips/sitenook-scanner:latest
# SITENOOK_POCKETBASE_IMAGE=ghcr.io/phatphillips/sitenook-pocketbase:latest
# SITENOOK_NGINX_IMAGE=ghcr.io/phatphillips/sitenook-nginx:latest
