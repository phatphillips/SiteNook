# Local dev: direct PocketBase port. Production (nginx): use /api
NUXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_DOMAIN=localhost
# Production: true — apex host redirects to /find-account (localhost apex unchanged)
# NUXT_PUBLIC_TENANT_ONLY=false
# Phase G: marketing landing at / on apex (separate from self-service signup)
# NUXT_PUBLIC_MARKETING_SITE=true
NUXT_POCKETBASE_URL=http://localhost:8090
NUXT_PB_ADMIN_EMAIL=admin@accessiq.local
NUXT_PB_ADMIN_PASSWORD=changeme_strong_password_here
# Server-only: org provisioning (POST /api/provision)
NUXT_PROVISION_API_KEY=changeme_provision_secret
# Shown on /signup invite-only page
NUXT_PUBLIC_SUPPORT_EMAIL=contact@your-org.com
# Self-service org signup (Phase F) — off by default until ready
# NUXT_PUBLIC_SELF_SERVICE_SIGNUP=true
#
# --- Stripe (Phase G) — see docs/stripe-setup.md ---
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NUXT_STRIPE_SECRET_KEY=sk_test_...
# NUXT_STRIPE_STARTER_PRICE_ID=price_...
# NUXT_STRIPE_TEAM_PRICE_ID=price_...
# NUXT_STRIPE_BUSINESS_PRICE_ID=price_...
# NUXT_STRIPE_STANDARD_PRICE_ID=price_...   # legacy alias for team monthly price
# NUXT_STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
# NUXT_STRIPE_TEAM_ANNUAL_PRICE_ID=price_...
# NUXT_STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_...
# NUXT_STRIPE_WEBHOOK_SECRET=whsec_...
# NUXT_PUBLIC_STRIPE_DEV_BYPASS=true
# NUXT_STRIPE_DEV_BYPASS_TOKEN=dev_bypass
# Optional Cloudflare Turnstile for POST /api/signup-organization
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# NUXT_TURNSTILE_SECRET=
# Optional terms link shown in /start wizard
# NUXT_PUBLIC_TERMS_URL=https://accessiq.com/terms
